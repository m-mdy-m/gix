#!/usr/bin/env sh

fail=0

unformatted=$(gofmt -l cmd internal 2>/dev/null)
if [ -n "$unformatted" ]; then
  echo "gix: not gofmt-formatted:" >&2
  echo "$unformatted" >&2
  echo "  run: make fmt" >&2
  fail=1
fi

if command -v go >/dev/null 2>&1; then
  if ! go vet ./...; then
    echo "  go vet failed" >&2
    fail=1
  fi
fi

exit $fail
