#!/usr/bin/env sh
#
# pre-push: keep pushes fast. The full test suite runs in CI on every push
# and pull request (.github/workflows/build.yml), and it spawns thousands
# of git processes, which takes many minutes on Windows. Locally this only
# checks that the code builds and vets.
#
#   GIX_FULL_TEST=1 git push      also run the whole test suite first
#   make test                     run the tests on their own
#
# Pushing only tags (a release) or deleting a branch checks nothing: the
# commit being tagged was already checked when it was pushed.

zero=0000000000000000000000000000000000000000
needs_check=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/tags/*) continue ;;
  esac
  # A delete pushes the all-zero object id (40 zeros, or 64 with SHA-256).
  if [ -z "$(printf '%s' "$local_sha" | tr -d '0')" ]; then
    continue
  fi
  needs_check=1
done

[ "$needs_check" = "1" ] || exit 0

if ! command -v go >/dev/null 2>&1; then
  echo "gix: go not found, skipping checks" >&2
  exit 0
fi

go build ./... || exit 1
go vet ./... || exit 1

if [ "${GIX_FULL_TEST:-}" = "1" ]; then
  go test ./... || exit 1
fi

exit 0
